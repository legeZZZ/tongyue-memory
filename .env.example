# 同月记忆 (tongyue-memory). The process still reads MNEME_* and imports the mneme package.
# Copy to .env and fill in before a real evaluation.
# Leave MNEME_FAKE_MODELS=1 only for offline smoke. Eval must use the real models.

# Auth. Unset or empty = open (local smoke only).
# When set, /add and /search accept Authorization: Bearer, Authorization: Token, or X-Api-Key.
# /health stays unauthenticated. Use the same value you register as the Memory System Key.
MEMORY_SYSTEM_KEY=

# text-embedding-v4 (1024d). OpenAI-compatible DashScope endpoint.
# text_type=document on Add, text_type=query on Search.
DASHSCOPE_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# gpt-4o-mini: fact extract, temporal classify, recall rewrite, conflict judge.
# Search does not ask the model to answer.
# Official base: https://api.openai.com/v1
# tryallapi (OpenAI-compatible gateway): https://tryallapi.com/v1
# Put the gateway key in OPENAI_API_KEY. Do not commit a real key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Per-call client timeouts. Search does not wait the full LLM timeout: see
# MNEME_SEARCH_BUDGET_S. These still bound Add embeddings and fact extraction.
EMBEDDING_TIMEOUT_S=40
LLM_TIMEOUT_S=30

# Search returns within this many seconds even if gpt-4o-mini or DashScope stalls.
# Analyze and the query embedding run together. On timeout Search uses the
# heuristic tense label and/or FTS, and still returns 200. The HTTP handler
# gives up 15s after this budget so a stuck call cannot hit a ~100s proxy timeout.
MNEME_SEARCH_BUDGET_S=20
MNEME_SEARCH_LLM_TIMEOUT_S=8
# In-flight fact extraction jobs. Extra chunks stay queued instead of stampeding
# SQLite and the LLM during a Full eval.
MNEME_ENRICH_CONCURRENCY=2
# Threads for /search only. /add keeps the server pool.
MNEME_SEARCH_WORKERS=48

# lexical (default, no weights) or qwen3 (pip install 'tongyue-memory[qwen]').
MNEME_RERANKER=lexical
QWEN_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

MNEME_TAU=0.25
MNEME_BETA=0.5
MNEME_GAMMA=0.2
MNEME_RRF_K=60
MNEME_FACT_TIMEOUT_S=12
MNEME_DB=/data/mneme.db
PORT=8097

# Offline deterministic models. Must be 0 or unset for Eval.
MNEME_FAKE_MODELS=0

# Optional path to the wangfenjin/simple FTS5 extension (jieba inside SQLite).
# If unset, 同月记忆 indexes jieba tokens plus an FTS5 trigram table.
MNEME_FTS_SIMPLE=
